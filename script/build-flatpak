#!/usr/bin/env bash
# Purpose: build a local Flatpak of this Zed fork and install it for the current
# user, so the file manager panel can be launched from the app grid instead of
# from `target/debug/zed`.
#
# Usage:
#   script/build-flatpak                  # build the release binary if needed, then package
#   script/build-flatpak --skip-build     # package the existing target/release/zed
#   script/build-flatpak --binary PATH    # package an explicit binary (smoke tests)
#   script/build-flatpak --bundle         # also write target/release/<id>.flatpak
#   script/build-flatpak --manifest-only  # stop after staging the inputs
#
# Why the binary is built outside the sandbox:
#   Compiling Zed inside `flatpak-builder` needs the Rust toolchain in the SDK,
#   a network-enabled build sandbox (webrtc-sys downloads its prebuilt archive)
#   and a long dependency chain. Packaging the binary we already build with
#   `script/build-zed` is a couple of seconds, and its dynamic dependencies are
#   in `org.freedesktop.Platform` (see flatpak/io.github.qipn.ZedFileManager.yml).
#
# Created: 2026-11-07

set -euo pipefail

cd "$(dirname "$0")/.."

APP_ID=io.github.qipn.ZedFileManager
MANIFEST="flatpak/$APP_ID.yml"
BUILD_DIR="flatpak/build"
STATE_DIR="flatpak/.builder"
BUILD_INPUT="flatpak/build-input"

SKIP_BUILD=0
BINARY=""
WRITE_BUNDLE=0
MANIFEST_ONLY=0

usage() {
    cat <<'EOF'
Usage: script/build-flatpak [options]

Options:
  --skip-build      do not run script/build-zed; use target/release/zed
  --binary PATH     package this binary instead of target/release/zed
  --bundle          also export target/release/<app-id>.flatpak
  --manifest-only   stage the inputs and stop (no flatpak-builder run)
  -h, --help        show this help
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --skip-build) SKIP_BUILD=1; shift ;;
        --binary) BINARY="$2"; shift 2 ;;
        --bundle) WRITE_BUNDLE=1; shift ;;
        --manifest-only) MANIFEST_ONLY=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "error: unknown argument '$1'" >&2; usage; exit 1 ;;
    esac
done

for tool in flatpak flatpak-builder; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "error: $tool is required (NixOS: nix-shell -p flatpak flatpak-builder)" >&2
        exit 1
    fi
done

# 解析 nix 的 libwayland-client 目录，写进生成的 launcher。
#
# 为什么必须是 nix 的，而不是 org.freedesktop.Platform 里的：
#   沙箱里的进程是 /nix/store 的 ld.so，gpui 靠 dlopen("libwayland-client.so.0") 拿
#   Wayland；而 nix mesa 26.x 的 EGL/Vulkan 驱动自己也 NEEDED 同一个 soname。
#   LD_LIBRARY_PATH 的优先级高于 RUNPATH，所以只会加载**一份**：运行时的 1.23 缺
#   wl_fixes_interface，会让 mesa 的 EGL（Client extensions: []）和 Vulkan
#   （ERROR_INCOMPATIBLE_DRIVER）全部加载失败，wgpu 一个 HAL 后端都建不起来。
#   所以取 mesa 自己 RUNPATH 里那份（也就是二进制实际链接的那份 1.25）。
resolve_wayland_lib() {
    if [[ -n "${ZED_WAYLAND_LIB:-}" ]]; then
        printf '%s\n' "$ZED_WAYLAND_LIB"
        return 0
    fi

    local vendor_json mesa dir
    vendor_json="${EGL_VENDOR_FILE:-/run/opengl-driver/share/glvnd/egl_vendor.d/50_mesa.json}"
    if [[ -r "$vendor_json" ]]; then
        mesa=$(sed -n 's/.*"library_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$vendor_json" | head -n1)
    fi
    if [[ -n "$mesa" && -e "$mesa" ]] && command -v readelf >/dev/null 2>&1; then
        while IFS= read -r dir; do
            if [[ -e "$dir/libwayland-client.so.0" ]]; then
                printf '%s\n' "$dir"
                return 0
            fi
        done < <(readelf -d "$mesa" 2>/dev/null | grep -E 'RUNPATH|RPATH' | grep -oE '/nix/store/[^]:]+')
    fi

    # 兜底：store 里版本最高的 wayland（wayland-protocols 之类靠 -client 存在性过滤）
    for dir in $(ls -d /nix/store/*-wayland-[0-9]*/lib 2>/dev/null | sort -V -r); do
        if [[ -e "$dir/libwayland-client.so.0" ]]; then
            printf '%s\n' "$dir"
            return 0
        fi
    done
    return 1
}

if [[ -z "$BINARY" ]]; then
    if [[ "$SKIP_BUILD" != 1 ]]; then
        echo "building the release binary (this takes a while on a cold target dir)..."
        script/build-zed --release
    fi
    BINARY="target/release/zed"
fi

if [[ ! -f "$BINARY" ]]; then
    echo "error: $BINARY does not exist." >&2
    echo "hint: run script/build-zed --release, or pass --binary <path>." >&2
    exit 1
fi

echo "staging $BINARY"
rm -rf "$BUILD_INPUT"
mkdir -p "$BUILD_INPUT"
install -Dm755 "$BINARY" "$BUILD_INPUT/zed"
install -Dm644 crates/zed/resources/app-icon.png "$BUILD_INPUT/app-icon.png"

# 生成的 launcher：把 nix 的 wayland 放到 LD_LIBRARY_PATH 最前面，然后 exec 真正的二进制。
# 找不到时退化成直通（非 NixOS 打包机），不会让打包失败。
WAYLAND_LIB=$(resolve_wayland_lib || true)
if [[ -n "$WAYLAND_LIB" ]]; then
    echo "wayland: $WAYLAND_LIB"
else
    echo "warn: 没定位到 nix 的 libwayland-client，launcher 不会改写 LD_LIBRARY_PATH。" >&2
    echo "hint: 非 NixOS 打包机属正常；NixOS 上可用 ZED_WAYLAND_LIB=/nix/store/...-wayland-x.y.z/lib 覆盖。" >&2
fi

{
    echo '#!/bin/sh'
    echo '# 由 script/build-flatpak 生成，不要手改。'
    echo '# 宿主工具链：沙箱的 PATH 只有 /app/bin:/usr/bin，但 nix-shell、cargo、'
    echo '# cc、pkg-config 都在 NixOS 的系统 profile 里（已由 manifest 只读挂进沙箱）。'
    echo '# 放在最前面，Zed 自己 spawn 的进程（语言服务器、git、任务终端）也能用到。'
    echo 'export PATH="/run/current-system/sw/bin:$PATH"'
    echo '# Flatpak 给应用的 SHELL 是 /bin/sh（运行时里的 bash 以 sh 模式跑），于是终端不读'
    echo '# ~/.bashrc / ~/.zshrc、也没有补全。get_system_shell() 只看 $SHELL'
    echo '# （crates/util/src/shell.rs），而 flatpak-spawn 没有默认 shell（会报'
    echo '# "No command specified"），所以这里问一次宿主的登录 shell（约 7ms），'
    echo '# 问不到再退回系统 profile 里的 bash。'
    echo 'case "${SHELL:-}" in'
    echo '    "" | /bin/sh | /usr/bin/sh)'
    echo '        host_shell=$(flatpak-spawn --host /bin/sh -c '\''printf %s "$SHELL"'\'' 2>/dev/null || true)'
    echo '        if [ -n "$host_shell" ] && [ -x "$host_shell" ]; then'
    echo '            export SHELL="$host_shell"'
    echo '        elif [ -x /run/current-system/sw/bin/bash ]; then'
    echo '            export SHELL=/run/current-system/sw/bin/bash'
    echo '        fi'
    echo '        ;;'
    echo 'esac'
    echo '# 沙箱里的 /etc 是运行时的 /etc，读不到 /etc/nix/nix.conf；'
    echo '# 用 NIX_CONFIG 补上 flake 特性，否则 nix-command / flakes 不可用。'
    echo 'export NIX_CONFIG="${NIX_CONFIG:-experimental-features = nix-command flakes}"'
    echo '# 普通用户不能直接写 /nix/store，必须走宿主的 nix-daemon（socket 在 /nix/var，'
    echo '# 已由 manifest 以 rw 挂入）。好处是 nix 自己的构建沙箱跑在宿主侧，'
    echo '# 不会和外层 flatpak 的 user namespace 叠加。'
    echo 'export NIX_REMOTE=daemon'
    if [[ -n "$WAYLAND_LIB" ]]; then
        echo '# 原生 Wayland：必须用 nix 这份 libwayland-client，用 flatpak 运行时的 1.23 会让'
        echo '# mesa 26.x 的 EGL/Vulkan 驱动因缺 wl_fixes_interface 而加载失败。'
        echo "WAYLAND_LIB=$WAYLAND_LIB"
        echo 'export LD_LIBRARY_PATH="$WAYLAND_LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"'
    fi
    echo 'exec /app/bin/zed-bin "$@"'
} > "$BUILD_INPUT/zed-launcher"
chmod 755 "$BUILD_INPUT/zed-launcher"

if [[ "$MANIFEST_ONLY" == 1 ]]; then
    echo "inputs staged in $BUILD_INPUT; not running flatpak-builder"
    exit 0
fi

# `org.freedesktop.Platform` / `Sdk` 24.08 come from Flathub; make sure they are
# present before flatpak-builder tries to use them.
if ! flatpak list --runtime --columns=application,branch | grep -qE "^org\.freedesktop\.Sdk[[:space:]]+24\.08$"; then
    echo "error: org.freedesktop.Sdk//24.08 is not installed." >&2
    echo "hint: flatpak install flathub org.freedesktop.Sdk//24.08 org.freedesktop.Platform//24.08" >&2
    exit 1
fi

flatpak-builder \
    --user \
    --install \
    --force-clean \
    --state-dir="$STATE_DIR" \
    "$BUILD_DIR" \
    "$MANIFEST"

if [[ "$WRITE_BUNDLE" == 1 ]]; then
    repo="${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/repo"
    bundle="target/release/$APP_ID.flatpak"
    mkdir -p target/release
    flatpak build-bundle "$repo" "$bundle" "$APP_ID" --runtime-repo=https://flathub.org/repo/flathub.flatpakrepo
    echo "wrote $bundle"
fi

cat <<EOF

Installed '$APP_ID'. Launch it with:
  flatpak run $APP_ID
or from the desktop's application grid ("Zed File Manager").
EOF
