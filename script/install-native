#!/usr/bin/env bash
# Purpose: 用**硬链接**把编译产物装成原生应用（不复制、不占额外空间）。
#
#   产物                       →  安装位置
#   target/release/zed         →  ~/.local/lib/zed/zed-editor
#   target/release/cli         →  ~/.local/bin/zeditor
#   desktop / 图标 / metainfo  →  ~/.local/share/…
#
# Usage:
#   script/install-native               # 安装或重新安装
#   script/install-native --uninstall   # 删掉本脚本装过的东西
#   script/install-native -h            # 显示这段说明
#
# 为什么要装两个文件（editor + CLI）：
#   单实例是 CLI 做的（crates/cli/src/main.rs 的 launch()）：它连
#   ~/.local/share/zed/zed-<channel>.sock，连上就把请求发过去（已有实例开窗口），
#   连不上才 fork 起 editor。只装 editor 的话，从菜单栏每点一次就新起一个进程，
#   于是"点固定图标又冒出一个新图标"。
#   CLI 找 editor 的顺序是 ../libexec/zed-editor、../lib/zed/zed-editor、./zed，
#   所以 editor 放在 ~/.local/lib/zed/ 下正好被找到，且不占用 `zed` 这个名字
#   （NixOS 上那个 `zed` 是 ZFS Event Daemon，不能遮蔽）。
#
# 为什么 desktop 文件叫 dev.zed.Zed-Dev.desktop：
#   Wayland 下 GNOME 用窗口的 app_id 去匹配**同名**的 .desktop 文件，X11 下看
#   StartupWMClass。我们的版本串是 1.28.0+dev，ReleaseChannel::app_id() 返回
#   "dev.zed.Zed-Dev"（crates/release_channel/src/lib.rs）。名字对不上，面板就会
#   把窗口当成另一个应用：固定的图标旁边再生一个。
#
# Wayland 库：gpui 用 dlopen("libwayland-client.so.0")，而进程跑在 nix 的 ld.so 下，
#   看不到运行时那份。所以 .desktop 的 Exec 用 env 只给这个程序注入
#   LD_LIBRARY_PATH。它只在"当前没有实例、需要新起 editor"时才用得到；已经有实例
#   在跑时 CLI 只发一个 datagram，从任何 shell 直接 `zeditor .` 都能用。
#
# Created: 2026-11-07

set -euo pipefail

cd "$(dirname "$0")/.."

APP_ID=dev.zed.Zed-Dev                 # 与 ReleaseChannel::app_id() 一致
PROG=zeditor                           # 不叫 zed：那是 ZFS Event Daemon

EDITOR_SRC=target/release/zed
CLI_SRC=target/release/cli

HOME_LOCAL="$HOME/.local"
EDITOR_DST="$HOME_LOCAL/lib/zed/zed-editor"
CLI_DST="$HOME_LOCAL/bin/$PROG"
DESKTOP_DST="$HOME_LOCAL/share/applications/$APP_ID.desktop"
ICON_DST="$HOME_LOCAL/share/icons/hicolor/512x512/apps/io.github.qipn.ZedFileManager.png"
METAINFO_DST="$HOME_LOCAL/share/metainfo/io.github.qipn.ZedFileManager.metainfo.xml"

# 上一版（单文件 + sh 启动器 + 不同 desktop 名）留下的东西，安装/卸载时一并清掉
LEGACY=(
    "$HOME_LOCAL/bin/zeditor-bin"
    "$HOME_LOCAL/bin/zed-filemanager"
    "$HOME_LOCAL/bin/zed-filemanager-bin"
    "$HOME_LOCAL/share/applications/io.github.qipn.ZedFileManager.desktop"
)

usage() { awk 'NR>1 { if (/^#/) { sub(/^# ?/, ""); print } else { exit } }' "$0"; }
die() { echo "error: $*" >&2; exit 1; }

UNINSTALL=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --uninstall) UNINSTALL=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown argument '$1'（只支持 --uninstall / -h）" ;;
    esac
done

refresh_desktop_db() {
    command -v update-desktop-database >/dev/null 2>&1 &&
        update-desktop-database "$HOME_LOCAL/share/applications" >/dev/null 2>&1 || true
}

cleanup_legacy() {
    local path
    for path in "${LEGACY[@]}"; do
        [[ -e "$path" || -L "$path" ]] && { echo "  清理旧文件 $path"; rm -f "$path"; }
    done
}

if [[ "$UNINSTALL" == 1 ]]; then
    for path in "$EDITOR_DST" "$CLI_DST" "$DESKTOP_DST" "$ICON_DST" "$METAINFO_DST"; do
        [[ -e "$path" || -L "$path" ]] && { echo "removing $path"; rm -f "$path"; }
    done
    cleanup_legacy
    refresh_desktop_db
    echo "done。数据目录 ~/.local/share/zed 与 ~/.config/zed 未动。"
    exit 0
fi

# nix 的 libwayland-client：优先 ZED_WAYLAND_LIB，否则取 store 里版本最高的那份。
wayland_lib() {
    [[ -n "${ZED_WAYLAND_LIB:-}" ]] && { printf '%s\n' "$ZED_WAYLAND_LIB"; return 0; }
    local dir
    for dir in $(ls -d /nix/store/*-wayland-[0-9]*/lib 2>/dev/null | sort -V -r); do
        [[ -e "$dir/libwayland-client.so.0" ]] && { printf '%s\n' "$dir"; return 0; }
    done
    return 1
}

hardlink() {
    local src=$1 dst=$2
    [[ "$src" != "$dst" ]] || die "源与目标同一文件（$src）"
    [[ -x "$src" ]] || die "$src 不存在或不可执行"
    mkdir -p "$(dirname "$dst")"
    rm -f "$dst"                       # 断开上一次留下的符号链接 / 旧 inode
    if ln "$src" "$dst" 2>/dev/null; then
        echo "  hardlink $(basename "$dst")"
    else
        echo "  warn: 硬链接失败（跨文件系统？），退化为拷贝 $(basename "$dst")" >&2
        install -Dm755 "$src" "$dst"
    fi
}

[[ -x "$CLI_SRC" ]] || die "没找到 $CLI_SRC。单实例需要 CLI：
      script/build-zed --release -- -p cli"

WAYLAND_LIB=$(wayland_lib || true)

echo "installing"
hardlink "$EDITOR_SRC" "$EDITOR_DST"
hardlink "$CLI_SRC" "$CLI_DST"

install -d "$HOME_LOCAL/share/applications" \
    "$HOME_LOCAL/share/icons/hicolor/512x512/apps" "$HOME_LOCAL/share/metainfo"

# Exec 里注入 LD_LIBRARY_PATH（只有首次拉起 editor 才用得到）；TryExec 不能带 env。
if [[ -n "$WAYLAND_LIB" ]]; then
    EXEC_LINE="Exec=env LD_LIBRARY_PATH=$WAYLAND_LIB $CLI_DST %U"
else
    echo "warn: 没找到 nix 的 libwayland-client；Wayland 会话里首次启动可能 panic" >&2
    EXEC_LINE="Exec=$CLI_DST %U"
fi
sed -e "s|^TryExec=.*|TryExec=$CLI_DST|" \
    -e "s|^Exec=.*|$EXEC_LINE|" \
    "flatpak/io.github.qipn.ZedFileManager.desktop" > "$DESKTOP_DST"
# Wayland 用文件名匹配，X11 用这一行匹配
sed -i "/^TryExec=/a StartupWMClass=$APP_ID" "$DESKTOP_DST"

install -Dm644 crates/zed/resources/app-icon.png "$ICON_DST"
install -Dm644 "flatpak/io.github.qipn.ZedFileManager.metainfo.xml" "$METAINFO_DST"

cleanup_legacy
refresh_desktop_db

cat <<EOF

装好了
  CLI（单实例网关）: $CLI_DST
  editor:            $EDITOR_DST   （与 target/release/zed 共享 inode）
  desktop:           $DESKTOP_DST
  app_id / WM_CLASS: $APP_ID

用法
  $PROG .                     # 已有实例 → 在那个实例里开；没有 → 起一个
  $PROG --new .               # 强制开新窗口
从应用网格启动的名称是 "Zed File Manager"。

注意
- 首次启动若从终端手动跑、且当前没有实例，需要带上 Wayland 库路径：
    LD_LIBRARY_PATH=$WAYLAND_LIB $PROG .
  经 .desktop 启动（或已有实例在跑）不需要。
- 数据在 ~/.local/share/zed 与 ~/.config/zed（dev 通道用 db/0-dev）。
EOF
